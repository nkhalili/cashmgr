{
  "name": "@cashmgr/desktop",
  "version": "0.1.0-rc.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Electron desktop app for Cash Mgr.",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:web": "pnpm --filter @cashmgr/web dev",
    "dev:electron": "tsc && NODE_ENV=development VITE_PORT=3000 electron .",
    "build": "npm-run-all build:*",
    "build:web": "pnpm --filter @cashmgr/web build",
    "build:electron": "tsc",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cashmgr/core": "workspace:*",
    "@cashmgr/db": "workspace:*",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "electron": "^28.1.4",
    "electron-builder": "^24.9.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "app.cashmgr",
    "productName": "Cash Mgr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../web/dist/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
