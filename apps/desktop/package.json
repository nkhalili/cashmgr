{
  "name": "@cashmgr/desktop",
  "version": "0.9.9",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Electron desktop app for Cash Mgr.",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:web": "pnpm --filter @cashmgr/web dev",
    "dev:electron": "node build.mjs && NODE_ENV=development VITE_PORT=3000 electron .",
    "build": "npm-run-all build:*",
    "build:web": "pnpm --filter @cashmgr/web build",
    "build:electron": "node build.mjs",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cashmgr/core": "workspace:*",
    "@cashmgr/db": "workspace:*",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "electron": "^28.1.4",
    "esbuild": "^0.27.0",
    "electron-builder": "^24.9.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "app.cashmgr",
    "productName": "Cash Mgr",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      {
        "from": "../web/dist",
        "to": "web/dist"
      }
    ],
    "afterSign": "build/notarize.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "nkhalili",
      "repo": "cashmgr"
    }
  }
}
